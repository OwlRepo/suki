# Development
ENABLE_DEV_TOOLS=true

# Database (e.g. PostgreSQL, Turso, Neon)
# For Docker Compose dev: use postgresql://postgres:postgres@postgres:5432/tyvera
# For local dev: use postgresql://postgres:postgres@localhost:5432/tyvera
DATABASE_URL=

# Local auth
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_DAYS=30
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=3

# Optional: bootstrap a default test owner account at API startup
AUTH_BOOTSTRAP_DEFAULT_ACCOUNT=false
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ORG_NAME=Default Test Organization

# OpenAI (for AI message generation)
OPENAI_API_KEY=
# AI abuse guardrails (daily UTC caps; defaults are used if unset)
# AI_DAILY_REQUEST_LIMIT=150
# AI_DAILY_TOKEN_LIMIT=150000

# Lemon Squeezy billing (self-serve billing stays disabled until Test mode is verified)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
LEMONSQUEEZY_VARIANT_STARTER_ANNUAL=
LEMONSQUEEZY_VARIANT_GROWTH_MONTHLY=
LEMONSQUEEZY_VARIANT_GROWTH_ANNUAL=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=
LEMONSQUEEZY_VARIANT_ONLINE_BOOKING_TOPUP_10=
LEMONSQUEEZY_VARIANT_ONLINE_BOOKING_TOPUP_25=
LEMONSQUEEZY_VARIANT_ONLINE_BOOKING_TOPUP_50=
LEMONSQUEEZY_VARIANT_ONLINE_BOOKING_TOPUP_100=
LEMONSQUEEZY_VARIANT_ONLINE_BOOKING_TOPUP_250=
LEMONSQUEEZY_VARIANT_SMS_SEGMENT_TOPUP_25=
LEMONSQUEEZY_VARIANT_SMS_SEGMENT_TOPUP_50=
LEMONSQUEEZY_VARIANT_SMS_SEGMENT_TOPUP_100=
LEMONSQUEEZY_VARIANT_SMS_SEGMENT_TOPUP_250=

# PII encryption (32-byte key, base64; for customers.mobile/email at rest)
# Generate: openssl rand -base64 32
PII_ENCRYPTION_KEY_BASE64=

# Twilio (SMS sending, inbound STOP handling, status callbacks, and booking OTP)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER=
# TWILIO_STATUS_CALLBACK_URL=https://tyvera.app/api/messaging/webhooks/twilio/status
# TWILIO_INBOUND_SMS_WEBHOOK_URL=https://tyvera.app/api/messaging/inbound/sms
# TWILIO_VERIFY_SERVICE_SID=

# Resend (email sending and webhooks)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_WEBHOOK_SECRET=

# Request access / contact (mailto when users want to get started)
NEXT_PUBLIC_REQUEST_ACCESS_URL=mailto:romeo.webeng@gmail.com?subject=Request%20access%20to%20Tyvera

# Founder allowlist (comma-separated) for manual billing controls
# FOUNDER_ALLOWLIST_EMAILS=founder@example.com,admin@example.com
# FOUNDER_ALLOWLIST_USER_IDS=user_2abc,user_2xyz

# Feature flags (true/false; production defaults to false unless set)
# FF_founder_led_mode_enabled=true
# FF_self_serve_billing_enabled=false
# FF_annual_billing_checkout_enabled=false
# FF_auto_messaging_enabled=
# FF_auto_followups_scheduler_enabled=
# FF_billing_grace_enforced=
# FF_sms_metering_enforced=
# FF_security_audit_enabled=

# Billing tuning
# BILLING_GROWTH_VERIFIED_BOOKINGS_PER_MONTH=80

# Public booking OTP abuse controls
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_HOLD=3
# OTP_PER_MOBILE_LIMIT=5
# OTP_PER_MOBILE_WINDOW_MINUTES=60
# OTP_PER_IP_LIMIT=10
# OTP_PER_IP_WINDOW_MINUTES=60
# OTP_PER_BUSINESS_DAILY_LIMIT=100

# Follow-up abuse guardrails (daily UTC caps; defaults are used if unset)
# FOLLOWUP_DAILY_ORG_LIMIT=500
# FOLLOWUP_DAILY_BUSINESS_LIMIT=300
# FOLLOWUP_DAILY_USER_LIMIT=120

# API URL (for frontend)
# Docker dev: http://localhost:3001  (browser on host connects to exposed port)
# Production default: /api  (same-origin browser path rewritten by Next to the API container)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL (for API CORS; set by compose or use default)
# FRONTEND_URL=http://localhost:3000

# Optional real-provider smoke tests (API)
# SMOKE_REAL_PROVIDERS=true
# SMOKE_TWILIO_TO=+639171234567
# SMOKE_RESEND_TO=deliverability@example.com
