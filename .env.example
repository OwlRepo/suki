# Development (API: enables dev-only endpoints like /billing/dev-switch-plan)
ENABLE_DEV_TOOLS=true

# Database (e.g. PostgreSQL, Turso, Neon)
# For Docker Compose dev: use postgresql://postgres:postgres@postgres:5432/suki
# For local dev: use postgresql://postgres:postgres@localhost:5432/suki
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI (for AI message generation)
OPENAI_API_KEY=

# PayMongo (Philippine payments)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# PII encryption (32-byte key, base64; for customers.mobile/email at rest)
# Generate: openssl rand -base64 32
PII_ENCRYPTION_KEY_BASE64=

# Twilio (SMS sending and status callbacks)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER=
# TWILIO_STATUS_CALLBACK_URL=

# Resend (email sending and webhooks)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_WEBHOOK_SECRET=

# Founder allowlist (comma-separated) for manual billing controls
# FOUNDER_ALLOWLIST_EMAILS=founder@example.com,admin@example.com
# FOUNDER_ALLOWLIST_USER_IDS=user_2abc,user_2xyz

# Feature flags (true/false; production defaults to false unless set)
# FF_auto_messaging_enabled=
# FF_auto_followups_scheduler_enabled=
# FF_billing_grace_enforced=
# FF_sms_metering_enforced=
# FF_security_audit_enabled=

# API URL (for frontend; browser must reach API - use localhost even in Docker)
# Docker dev: http://localhost:3001  (browser on host connects to exposed port)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL (for API CORS; set by compose or use default)
# FRONTEND_URL=http://localhost:3000
