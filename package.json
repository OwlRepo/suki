{
  "name": "tyvera-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run db:setup && turbo run dev",
    "dev:web": "turbo run dev --filter=@tyvera/web",
    "dev:api": "turbo run dev --filter=@tyvera/api",
    "build": "bun run db:setup && turbo run build",
    "build:web": "turbo run build --filter=@tyvera/web...",
    "build:api": "turbo run build --filter=@tyvera/api...",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=@tyvera/database",
    "db:setup": "turbo run db:setup --filter=@tyvera/database",
    "db:migrate": "turbo run db:migrate --filter=@tyvera/database",
    "db:studio": "turbo run db:studio --filter=@tyvera/database",
    "db:seed": "turbo run db:seed --filter=@tyvera/database",
    "db:seed-platform-admin-rbac": "turbo run db:seed-platform-admin-rbac --filter=@tyvera/database",
    "db:bootstrap-platform-admin": "turbo run db:bootstrap-platform-admin --filter=@tyvera/database",
    "db:reset": "turbo run db:reset --filter=@tyvera/database",
    "db:reconcile-orphans": "turbo run db:reconcile-orphans --filter=@tyvera/database",
    "update:ai-indexes": "bun run scripts/update-ai-indexes.ts",
    "check:assistant-context-governance": "bun run scripts/check-assistant-context-governance.ts",
    "prepare": "husky",
    "test": "turbo run test",
    "docker:dev:up": "docker compose up -d",
    "docker:dev:build": "docker compose -f docker-compose.yml build",
    "docker:dev:down": "docker compose down",
    "docker:dev:logs": "docker compose logs -f",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "push:api:acr": "./scripts/push-api-to-acr.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "turbo": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "packageManager": "bun@1.0.0",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "openai": "^6.22.0",
    "qrcode": "^1.5.4",
    "svix": "^1.85.0"
  }
}
