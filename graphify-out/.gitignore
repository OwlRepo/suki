# Machine-local interpreter/root pointers and the extraction cache.
.graphify_python
.graphify_root
.vocab.txt
cache/
.graphify_analysis.json
.spec_prompt.txt
.chunks.json
.ast.log

# Graphify's own dated/signature artefacts — never meant for git.
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
*.sig

# Intermediate extraction files, regenerated on every build.
fragments/
.graphify_detect.json
.graphify_ast.json
.graphify_semantic.json
.graphify_extract.json
.graphify_chunk_*.json
.graphify_cached.json
.graphify_uncached.txt
.graphify_semantic_new.json

# Interactive view is regenerated by `graphify export html`; keep git lean.
graph.html
